# Python caches and local environments
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# Local credentials and machine-specific settings
.env
.env.*
config/settings.json
*.pem
*.key

# Customer and corporate master data (the remote repository is public)
config/domain_master.json
config/ship_to_master.json
config/material_master.json
config/unknown_dismissed.json
config/erp_template.XLSX
config/erp_template.xlsx
CodeExtract/material_codes_reference.csv
