CodeExtract/_legacy/engine_baseline.json

# Runtime mail, attachments, generated ERP files, and logs
data/
logs/
*.log
*.db
*.db-wal
*.db-shm

# Real/reference purchase orders and extraction results
CodeExtract/data_upload/
CodeExtract/data_cache/
CodeExtract/data_output/

# Local development scratch state; keep the reusable port probe
.workbuddy/*
!.workbuddy/port_probe.py

# Test mail may contain real messages
tests/test_mails/*
!tests/test_mails/README.txt

# Build/release output
build/
dist/
pydeps/
OrderFlow_src_*/
OrderFlow_src_*.zip

# Office temporary files and OS metadata
~$*
.DS_Store
._*
Thumbs.db
Desktop.ini
